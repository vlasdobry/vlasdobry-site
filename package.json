{
  "name": "vlas-dobry---marketer-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-blog.js && node scripts/postbuild.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc --project workers/health-score-proxy/tsconfig.json",
    "test:worker": "node --test workers/health-score-proxy/tests/*.test.mjs",
    "test:scoring": "node --test src/utils/healthScore/*.test.mjs",
    "smoke": "node scripts/smoke-routes.js",
    "check": "npm run test:worker && npm run test:scoring && npm run typecheck && npm run typecheck:worker && npm run build && npm run smoke"
  },
  "dependencies": {
    "@vlasdobry/geo-checker": "file:./vendor/vlasdobry-geo-checker-1.0.0.tgz",
    "dompurify": "^3.3.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.562.0",
    "marked": "^17.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.30.1",
      "sharp": "^0.35.5"
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "miniflare": "^4.20260730.0",
    "puppeteer": "^25.16.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
